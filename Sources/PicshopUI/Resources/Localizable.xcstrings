    "Drag the handles of the selected clip to trim, or say “coupe les 3 premières secondes”, “efface le passant”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles of the selected clip to trim, or say “coupe les 3 premières secondes”, “efface le passant”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées du clip pour le raccourcir, ou dites « coupe les 3 premières secondes », « efface le passant »."
          }
        }
      }
    },
