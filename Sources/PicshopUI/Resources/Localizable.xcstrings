    "Everything stays on the iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on the iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur l'iPhone."
          }
        }
      }
    },
    "Everything stays on the iPhone. Live listens, understands, looks at the picture and answers on the device — nothing is sent. PicShop has no server, no account and no tracking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on the iPhone. Live listens, understands, looks at the picture and answers on the device — nothing is sent. PicShop has no server, no account and no tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur l'iPhone. Live écoute, comprend, regarde l'image et répond sur l'appareil — rien n'est envoyé. PicShop n'a ni serveur, ni compte, ni pistage."
          }
        }
      }
    },
    "Everything stays on your iPhone: your voice, your words, your photos and videos. Live thinks on the device; nothing is sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your iPhone: your voice, your words, your photos and videos. Live thinks on the device; nothing is sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ton iPhone : ta voix, tes mots, tes photos et vidéos. Live réfléchit sur l'appareil ; rien n'est envoyé."
          }
        }
      }
    },
