    "“Efface le chien”, “make it warmer”, “coupe les 3 premières secondes”. PicShop understands French and English and edits instantly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Efface le chien”, “make it warmer”, “coupe les 3 premières secondes”. PicShop understands French and English and edits instantly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Efface le chien », « plus chaud », « coupe les 3 premières secondes ». PicShop comprend le français et l'anglais et retouche instantanément."
          }
        }
      }
    }
