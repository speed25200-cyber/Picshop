          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La gomme et l'upscaler sont livrés avec l'app. Le Remplissage génératif et le Pro Brain sont volumineux : ils se téléchargent seuls en Wi‑Fi la première fois, et tout fonctionne sur votre iPhone."
          }
        }
      }
    },
