    "About 200 spoken requests on a table screenshot and a poster, run through the on-device model: what it did to the picture and what it said. Keep the screen on; it takes several minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 200 spoken requests on a table screenshot and a poster, run through the on-device model: what it did to the picture and what it said. Keep the screen on; it takes several minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 200 demandes parlées sur une capture de tableau et une affiche, passées au modèle de l'iPhone : ce qu'il a fait à l'image et ce qu'il a dit. Garde l'écran allumé ; cela prend plusieurs minutes."
          }
        }
      }
    },
