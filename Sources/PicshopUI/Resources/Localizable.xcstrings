    "Photo requests with masks and selections, run through the on-device model: operation, arguments, applied and verified. Plug the iPhone in or keep it above 30 %; it takes several minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo requests with masks and selections, run through the on-device model: operation, arguments, applied and verified. Plug the iPhone in or keep it above 30 %; it takes several minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des demandes photo avec masques et sélections, passées au modèle de l'iPhone : opération, arguments, appliquée et vérifiée. Branchez l'iPhone ou gardez-le au-dessus de 30 % ; cela prend plusieurs minutes."
          }
        }
      }
    },
