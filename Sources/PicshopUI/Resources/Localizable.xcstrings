          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Efface le chien » · « Rends-la plus chaude » · « Ajoute des sous-titres »"
          }
        }
      }
    },
    "“Efface le chien”, “make it warmer”, “ajoute des sous-titres”. PicShop understands French and English and edits instantly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Efface le chien”, “make it warmer”, “ajoute des sous-titres”. PicShop understands French and English and edits instantly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Efface le chien », « make it warmer », « ajoute des sous-titres ». PicShop comprend le français et l'anglais et retouche instantanément."
          }
        }
      }
    }
