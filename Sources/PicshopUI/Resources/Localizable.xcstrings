          }
        }
      }
    },
    "PicShop always uses the most capable brain available on this iPhone. The instant grammar answers first; the language model steps in for complex or ambiguous requests. Everything runs on device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PicShop always uses the most capable brain available on this iPhone. The instant grammar answers first; the language model steps in for complex or ambiguous requests. Everything runs on device."
